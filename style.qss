/* ============================================================
   ✅ تنظیمات کلی (ریشه) - ImanAccount Modern Theme
   ============================================================ */

* {
    font-family: "Segoe UI", "Tahoma", "Vazirmatn", sans-serif;
    font-size: 10pt;
}

QWidget {
    background-color: #f5f7fa;
    color: #2c3e50;
}

/* ============================================================
   📌 منوی اصلی (Menu Bar)
   ============================================================ */

QMenuBar {
    background-color: #1a2332;
    color: #b0bec5;
    border: none;
    border-bottom: 2px solid #1976D2;
    padding: 4px 10px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1976D2;
    color: white;
}

QMenu {
    background-color: #1a2332;
    border: 1px solid #2c3e50;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px;
    color: #b0bec5;
}

QMenu::item:selected {
    background-color: #1976D2;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #2c3e50;
    margin: 5px 10px;
}

/* ============================================================
   📌 منوی کناری (Sidebar)
   ============================================================ */

QWidget#sidebar {
    background-color: #1a2332;
    border-right: 1px solid #2c3e50;
}

QPushButton#sidebarBtn {
    background-color: transparent;
    color: #b0bec5;
    border: none;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
    border-radius: 6px;
    font-size: 10pt;
    font-weight: 400;
}

QPushButton#sidebarBtn:hover {
    background-color: #2c3e50;
    color: white;
}

QPushButton#sidebarBtn:checked {
    background-color: #1976D2;
    color: white;
    font-weight: 500;
}

QPushButton#sidebarSubBtn {
    background-color: transparent;
    color: #7f8c8d;
    border: none;
    text-align: left;
    padding: 6px 16px 6px 32px;
    margin: 1px 8px;
    border-radius: 4px;
    font-size: 9pt;
    font-weight: 300;
}

QPushButton#sidebarSubBtn:hover {
    background-color: #2c3e50;
    color: #b0bec5;
}

QPushButton#sidebarSubBtn:checked {
    background-color: #1976D2;
    color: white;
    font-weight: 400;
}

QLabel#sidebarTitle {
    color: #7f8c8d;
    font-size: 9pt;
    font-weight: bold;
    padding: 12px 16px 5px 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QLabel#sidebarLogo {
    font-size: 28px;
    padding: 10px;
    color: #e94560;
}

QLabel#sidebarVersion {
    color: #5d6d7e;
    font-size: 9pt;
    padding: 10px;
    text-align: center;
}

QFrame#sidebarSeparator {
    background-color: #2c3e50;
    margin: 5px 15px;
    max-height: 1px;
}

/* ============================================================
   📌 ابزارها (Tools Sidebar)
   ============================================================ */

QWidget#toolsSidebar {
    background-color: #1a2332;
    border-right: 1px solid #2c3e50;
}

QLabel#toolsTitle {
    color: #e94560;
    font-size: 14pt;
    font-weight: bold;
    padding: 10px;
}

QPushButton#toolBtn {
    background-color: transparent;
    color: #b0bec5;
    border: none;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
    border-radius: 6px;
    font-size: 10pt;
    font-weight: 400;
}

QPushButton#toolBtn:hover {
    background-color: #2c3e50;
    color: white;
}

QPushButton#toolBtn:checked {
    background-color: #1976D2;
    color: white;
    font-weight: 500;
}

/* ============================================================
   📌 ناحیه محتوا
   ============================================================ */

QWidget#contentArea {
    background-color: #f5f7fa;
}

QWidget#toolsContent {
    background-color: #f5f7fa;
}

/* ============================================================
   📌 دکمه‌ها (Buttons)
   ============================================================ */

QPushButton {
    background-color: #1976D2;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1565C0;
}

QPushButton:pressed {
    background-color: #0d47a1;
}

QPushButton:disabled {
    background-color: #a0b0c0;
    color: #e0e0e0;
}

QPushButton#successBtn {
    background-color: #27ae60;
}
QPushButton#successBtn:hover {
    background-color: #1e8449;
}

QPushButton#dangerBtn {
    background-color: #e74c3c;
}
QPushButton#dangerBtn:hover {
    background-color: #c0392b;
}

QPushButton#warningBtn {
    background-color: #f39c12;
}
QPushButton#warningBtn:hover {
    background-color: #d68910;
}

QPushButton#infoBtn {
    background-color: #3498db;
}
QPushButton#infoBtn:hover {
    background-color: #2980b9;
}

/* ============================================================
   📌 جدول‌ها (TableWidget)
   ============================================================ */

QTableWidget {
    background-color: white;
    border: 1px solid #d5d8dc;
    border-radius: 8px;
    gridline-color: #e5e8ec;
    alternate-background-color: #f8f9fa;
}

QHeaderView::section {
    background-color: #eef2f5;
    color: #2c3e50;
    padding: 8px;
    border: none;
    font-weight: 600;
    border-bottom: 2px solid #d5d8dc;
}

QTableWidget::item:selected {
    background-color: #1976D2;
    color: white;
}

/* ============================================================
   📌 ورودی‌ها (LineEdit, SpinBox, ComboBox)
   ============================================================ */

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background-color: white;
    border: 1px solid #d5d8dc;
    border-radius: 6px;
    padding: 6px 10px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #1976D2;
    background-color: #f3f9ff;
}

/* ============================================================
   📌 گروه‌بندی (GroupBox)
   ============================================================ */

QGroupBox {
    border: 2px solid #d5d8dc;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 10px;
    background-color: #f5f7fa;
}

/* ============================================================
   📌 اسکرول‌بار (ScrollBar)
   ============================================================ */

QScrollBar:vertical {
    background: #f0f2f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

/* ============================================================
   📌 وضعیت (Status Bar)
   ============================================================ */

QStatusBar {
    background-color: #1a2332;
    color: white;
    font-weight: 500;
}

QStatusBar::item {
    border: none;
}

/* ============================================================
   📌 کارت‌ها و پنل‌ها
   ============================================================ */

QWidget#cardWidget {
    background-color: white;
    border-radius: 8px;
    border: 1px solid #d5d8dc;
}

QLabel#titleLabel {
    font-size: 16pt;
    font-weight: bold;
    padding: 10px;
    color: #1a2332;
}

QLabel#subtitleLabel {
    font-size: 12pt;
    font-weight: bold;
    padding: 5px;
    color: #2c3e50;
}

QLabel#netLabel {
    font-weight: bold;
    font-size: 16pt;
    color: #27ae60;
}

QLabel#taxLabel {
    font-weight: bold;
    color: #e67e22;
}

/* ============================================================
   📌 تب‌های داخلی
   ============================================================ */

QTabWidget::pane {
    border: 1px solid #d5d8dc;
    border-radius: 6px;
    background: white;
}

QTabBar::tab {
    background: #eef2f5;
    padding: 6px 14px;
    margin: 2px;
    border-radius: 4px;
}

QTabBar::tab:selected {
    background: #1976D2;
    color: white;
}
